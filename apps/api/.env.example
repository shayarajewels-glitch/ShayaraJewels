# ---------------------------------------------------------------------------
# Shayara API — copy to apps/api/.env and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Required to start
NODE_ENV=development
PORT=4000
# Local dev: run `npm run db:dev` and use the URI it prints, e.g.
#   mongodb://127.0.0.1:27017/shayara?replicaSet=rs0
# Production: your MongoDB Atlas connection string.
MONGODB_URI=
# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Optional: extra comma-separated origins allowed by CORS (FRONTEND_URL is always allowed)
CORS_ORIGINS=
# Number of reverse proxies in front of the API (1 behind Render/Railway/Nginx)
TRUST_PROXY=0
# auto = secure cookies in production only
COOKIE_SECURE=auto
# Only set when the web and API share a parent domain and you need it; leave empty otherwise
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
SESSION_TTL_DAYS=30

# Media uploads (UploadThing v7). Leave empty to disable uploads in development.
UPLOADTHING_TOKEN=
MEDIA_MAX_IMAGE_SIZE=4MB
MEDIA_MAX_VIDEO_SIZE=32MB
MEDIA_MAX_VIDEO_SECONDS=60

# Payments (Razorpay test keys start with rzp_test_). Leave empty to offer COD only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_WINDOW_MINUTES=30

# Email. Defaults: console (development), disabled (production) unless SMTP_HOST is set.
# MAIL_TRANSPORT=smtp
MAIL_FROM=Shayara <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

LOG_LEVEL=
RATE_LIMIT_ENABLED=true
JOBS_ENABLED=true

# Optional: instant storefront cache refresh after catalogue changes (same value in apps/web).
# Without it, storefront pages refresh within ~60 seconds.
REVALIDATE_SECRET=
# Defaults to ${FRONTEND_URL}/api/revalidate
WEB_REVALIDATE_URL=
