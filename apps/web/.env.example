# Shayara storefront — copy to apps/web/.env.local.
# Only NEXT_PUBLIC_* values reach the browser. Never put secrets here.

# Public URL of the Express API including the version prefix
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Public URL of this site (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: API URL used by the Next.js server for SSR when it differs from the
# public one (e.g. a private network address). Defaults to NEXT_PUBLIC_API_BASE_URL.
API_INTERNAL_BASE_URL=

# Server-only (no NEXT_PUBLIC_ prefix): must match REVALIDATE_SECRET in apps/api/.env.
REVALIDATE_SECRET=
